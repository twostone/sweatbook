{
  "name": "sweatbook",
  "version": "1.6.0",
  "private": true,
  "description": "Trainings-Tracker als Home-Assistant-App",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev:web": "vite",
    "check": "svelte-kit sync && svelte-check --tsconfig ./web/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
